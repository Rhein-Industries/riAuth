    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPublishable>false</IsPublishable>
    <DefineConstants>$(DefineConstants);DEVICE_STATE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../RiAuth.DeviceHost/WindowsStateStore.cs" Link="WindowsStateStore.cs" />
    <Compile Include="../RiAuth.DeviceHost/DeviceHost.cs" Link="DeviceHost.cs" />
  </ItemGroup>
</Project>
